    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
