{
  "name": "bomberman-pixelforge",
  "version": "1.0.0",
  "private": true,
  "description": "Bomberman — Battle Arena 2D de Captura la Bandera. PixelForge Studios.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
