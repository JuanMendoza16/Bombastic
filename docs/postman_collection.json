                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"jugador1\",\n  \"password\": \"secreto123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
