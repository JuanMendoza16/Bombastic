# Copiá este archivo como .env (o definí las variables en tu hosting)
PORT=8123
# Obligatorio en producción: una cadena larga y secreta
JWT_SECRET=cambiame-por-algo-largo-y-secreto
DB_PATH=data/bomberman.db
# LOG_FILE=data/server.log
# Crea un administrador al iniciar
# ADMIN_USER=admin
# ADMIN_PASS=una-contraseña-segura
# ADMIN_EMAIL=admin@ejemplo.com
# Si la web está en otro dominio (ej. GitHub Pages), permitir su origen:
# CORS_ORIGIN=https://usuario.github.io
# TRUST_PROXY=1
# Opcional: token de GitHub (con permiso actions:write) para disparar el build Docker desde el panel admin
# GH_DEPLOY_TOKEN=
# GH_REPO=JuanMendoza16/Bombastic
